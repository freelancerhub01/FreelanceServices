---
import { url } from '../utils/url';

interface Props {
  title?: string;
  subtitle?: string;
  primaryLabel?: string;
  primaryHref?: string;
}

const {
  title = "Ready to Build Something Great?",
  subtitle = "Let's turn your ideas into production-ready software. Reach out and let's discuss your project.",
  primaryLabel = "Start a Project",
  primaryHref = url('/contact'),
} = Astro.props;
---

<section class="py-20 fade-in" aria-labelledby="cta-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-2xl bg-gradient-to-br from-brand-600/20 to-indigo-900/20 border border-brand-600/20 p-10 md:p-16 text-center overflow-hidden">
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-brand-600/10 rounded-full blur-3xl"></div>
      </div>

      <h2 id="cta-heading" class="text-3xl md:text-4xl font-bold text-white mb-4">{title}</h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto mb-8">{subtitle}</p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={primaryHref} class="btn-primary text-base px-8 py-3.5 w-full sm:w-auto">
          {primaryLabel}
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a href="mailto:venkat.cotech@gmail.com" class="btn-secondary text-base px-8 py-3.5 w-full sm:w-auto">
          venkat.cotech@gmail.com
        </a>
      </div>
    </div>
  </div>
</section>
