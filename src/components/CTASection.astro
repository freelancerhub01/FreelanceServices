---
import { url } from '../utils/url';

interface Props {
  title?: string;
  subtitle?: string;
  primaryLabel?: string;
  primaryHref?: string;
}

const {
  title        = "Ready to Build Something Great?",
  subtitle     = "Let's turn your ideas into production-ready software. Reach out and let's discuss your project.",
  primaryLabel = "Start a Project",
  primaryHref  = url('/contact'),
} = Astro.props;
---

<section class="py-28 fade-in" aria-labelledby="cta-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl overflow-hidden p-12 md:p-20 text-center">

      <!-- Layered background -->
      <div class="absolute inset-0" aria-hidden="true">
        <div class="absolute inset-0" style="background:linear-gradient(135deg,rgba(30,27,75,.9),rgba(15,20,40,.95),rgba(30,10,60,.8))"></div>
        <div class="absolute inset-0 grid-bg opacity-30"></div>
        <!-- Animated orbs -->
        <div class="orb w-96 h-96 -top-20 -left-20 opacity-30" style="background:radial-gradient(circle,rgba(99,102,241,.6),transparent 70%);animation-duration:12s"></div>
        <div class="orb w-72 h-72 -bottom-10 -right-10 opacity-20" style="background:radial-gradient(circle,rgba(168,85,247,.6),transparent 70%);animation-duration:9s;animation-delay:-4s"></div>
        <div class="orb w-48 h-48 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-15" style="background:radial-gradient(circle,rgba(6,182,212,.5),transparent 70%);animation-duration:7s;animation-delay:-2s"></div>
      </div>

      <!-- Glowing border -->
      <div class="absolute inset-0 rounded-3xl pointer-events-none" aria-hidden="true"
           style="border:1px solid rgba(99,102,241,.2);box-shadow:inset 0 0 60px rgba(99,102,241,.05)"></div>

      <!-- Top neon line -->
      <div class="absolute top-0 left-1/4 right-1/4 neon-line" aria-hidden="true"></div>

      <div class="relative z-10">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-8 fade-in"
             style="background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.25)">
          <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          <span class="text-brand-300 text-sm font-semibold">Let's collaborate</span>
        </div>

        <h2 id="cta-heading" class="text-4xl md:text-6xl font-black text-white mb-5 leading-tight fade-in delay-100">
          {title}
        </h2>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto mb-12 leading-relaxed fade-in delay-200">
          {subtitle}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 fade-in delay-300">
          <a href={primaryHref} class="btn-primary ripple-btn text-lg px-12 py-4 w-full sm:w-auto">
            {primaryLabel}
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
          <a href="mailto:venkat.cotech@gmail.com" class="btn-secondary text-lg px-12 py-4 w-full sm:w-auto">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            venkat.cotech@gmail.com
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
