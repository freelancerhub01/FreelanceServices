---
import { url } from '../utils/url';

const navLinks = [
  { href: url('/'),        label: 'Home' },
  { href: url('/services'),label: 'Services' },
  { href: url('/about'),   label: 'About' },
  { href: url('/contact'), label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 px-4 pt-4">
  <div id="header-bar" class="max-w-7xl mx-auto rounded-2xl transition-all duration-500"
       style="background:rgba(3,7,18,.6);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.06)">

    <!-- Animated top border -->
    <div class="absolute top-0 left-8 right-8 h-px rounded-full neon-line opacity-50" aria-hidden="true"></div>

    <div class="px-5 sm:px-8">
      <div class="flex items-center justify-between h-14">

        <!-- Logo -->
        <a href={url('/')} class="flex items-center gap-3 group" aria-label="FreelanceHub home">
          <div class="relative w-9 h-9 rounded-xl flex items-center justify-center overflow-hidden"
               style="background:linear-gradient(135deg,#4f46e5,#a855f7)">
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 animate-hue"
                 style="background:linear-gradient(135deg,#6366f1,#06b6d4,#a855f7)" aria-hidden="true"></div>
            <svg class="relative z-10 w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
          </div>
          <span class="font-black text-lg text-white tracking-tight">
            Freelance<span class="gradient-text">Hub</span>
          </span>
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
          {navLinks.map(({ href, label }) => {
            const active = currentPath === href || (href !== url('/') && currentPath.startsWith(href));
            return (
              <a href={href} class={`relative px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-300 group ${active ? 'text-white' : 'text-gray-500 hover:text-white'}`}>
                {active && (
                  <span class="absolute inset-0 rounded-xl" aria-hidden="true"
                        style="background:linear-gradient(135deg,rgba(99,102,241,.2),rgba(168,85,247,.1));border:1px solid rgba(99,102,241,.3)"></span>
                )}
                <span class="absolute inset-0 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-200"
                      style="background:rgba(255,255,255,.04)" aria-hidden="true"></span>
                <span class="relative z-10">{label}</span>
              </a>
            );
          })}
          <a href={url('/contact')} class="btn-primary ml-3 text-sm py-2 px-5 ripple-btn">
            Hire Me
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
        </nav>

        <!-- Mobile button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-xl text-gray-400 hover:text-white transition-all duration-200"
                style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06)"
                aria-label="Toggle mobile menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg id="menu-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav -->
  <nav id="mobile-menu" class="hidden md:hidden max-w-7xl mx-auto mt-1 rounded-2xl overflow-hidden"
       style="background:rgba(3,7,18,.95);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,.06)"
       aria-label="Mobile navigation">
    <div class="px-4 py-3 space-y-1">
      {navLinks.map(({ href, label }) => {
        const active = currentPath === href || (href !== url('/') && currentPath.startsWith(href));
        return (
          <a href={href} class={`block px-4 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 ${active ? 'text-white' : 'text-gray-500 hover:text-white hover:bg-white/5'}`}
             style={active ? 'background:linear-gradient(135deg,rgba(99,102,241,.2),rgba(168,85,247,.1));border:1px solid rgba(99,102,241,.3)' : ''}>
            {label}
          </a>
        );
      })}
      <a href={url('/contact')} class="block mt-2 btn-primary text-sm py-2.5 text-center">Hire Me</a>
    </div>
  </nav>
</header>

<div class="h-20" aria-hidden="true"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const bar = document.getElementById('header-bar');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    menuIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Scroll shrink
  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      bar?.style.setProperty('background', 'rgba(3,7,18,.95)');
      bar?.style.setProperty('box-shadow', '0 4px 30px rgba(0,0,0,.6),0 0 0 1px rgba(99,102,241,.1)');
    } else {
      bar?.style.setProperty('background', 'rgba(3,7,18,.6)');
      bar?.style.setProperty('box-shadow', 'none');
    }
  }, { passive: true });

  // Ripple
  document.querySelectorAll('.ripple-btn').forEach(btn => {
    btn.addEventListener('click', (e: Event) => {
      const me = e as MouseEvent;
      const rect = (btn as HTMLElement).getBoundingClientRect();
      const circle = document.createElement('span');
      const size = Math.max(rect.width, rect.height);
      circle.className = 'ripple-circle';
      circle.style.cssText = `width:${size}px;height:${size}px;left:${me.clientX-rect.left-size/2}px;top:${me.clientY-rect.top-size/2}px`;
      btn.appendChild(circle);
      setTimeout(() => circle.remove(), 700);
    });
  });
</script>
