---
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  tags?: string[];
  index?: number;
}

const { title, description, icon, href, tags = [], index = 0 } = Astro.props;

const palettes = [
  { from:'#6366f1', to:'#a855f7', glow:'rgba(99,102,241,.5)'  },
  { from:'#06b6d4', to:'#6366f1', glow:'rgba(6,182,212,.5)'   },
  { from:'#a855f7', to:'#ec4899', glow:'rgba(168,85,247,.5)'  },
  { from:'#10b981', to:'#06b6d4', glow:'rgba(16,185,129,.5)'  },
  { from:'#f59e0b', to:'#ec4899', glow:'rgba(245,158,11,.5)'  },
  { from:'#3b82f6', to:'#06b6d4', glow:'rgba(59,130,246,.5)'  },
];
const p = palettes[index % palettes.length];
---

<a
  href={href}
  class="service-card group relative flex flex-col gap-4 rounded-2xl p-6 transition-all duration-500 overflow-hidden spotlight"
  style="background:rgba(15,20,40,.7);border:1px solid rgba(255,255,255,.06);backdrop-filter:blur(12px)"
  aria-label={`Learn more about ${title}`}
  data-glow={p.glow}
>
  <!-- Animated gradient border on hover -->
  <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none -z-10"
       style={`background:linear-gradient(135deg,${p.from}33,${p.to}22);padding:1px`}></div>

  <!-- Top shimmer line -->
  <div class="absolute top-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity duration-500"
       style={`background:linear-gradient(90deg,transparent,${p.from},${p.to},transparent)`}></div>

  <!-- Corner glow -->
  <div class="absolute -top-10 -right-10 w-24 h-24 rounded-full opacity-0 group-hover:opacity-30 transition-all duration-700 blur-2xl"
       style={`background:${p.from}`} aria-hidden="true"></div>

  <!-- Icon -->
  <div class="flex items-center gap-4">
    <div class="relative w-12 h-12 rounded-xl shrink-0 group-hover:scale-110 transition-transform duration-300"
         style={`background:linear-gradient(135deg,${p.from}22,${p.to}11);border:1px solid ${p.from}33`}>
      <div class="absolute inset-0 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 blur-sm"
           style={`background:${p.from}44`} aria-hidden="true"></div>
      <div class="relative z-10 w-full h-full flex items-center justify-center"
           style={`color:${p.from}`}>
        <Fragment set:html={icon} />
      </div>
    </div>
    <h3 class="text-base font-bold text-gray-200 group-hover:text-white transition-colors duration-300 leading-snug">
      {title}
    </h3>
  </div>

  <!-- Description -->
  <p class="text-gray-500 text-sm leading-relaxed flex-1 group-hover:text-gray-400 transition-colors duration-300">
    {description}
  </p>

  <!-- Tags -->
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map(tag => <span class="tag text-xs">{tag}</span>)}
    </div>
  )}

  <!-- Footer -->
  <div class="flex items-center justify-between pt-3 border-t transition-colors duration-300"
       style="border-color:rgba(255,255,255,.05)">
    <span class="text-xs font-semibold uppercase tracking-wider transition-colors duration-300"
          style={`color:${p.from}99`}
          data-hover-color={p.from}>
      Explore →
    </span>
    <div class="w-7 h-7 rounded-lg flex items-center justify-center transition-all duration-300 group-hover:translate-x-1"
         style={`background:${p.from}15;border:1px solid ${p.from}22`}>
      <svg class="w-3.5 h-3.5 transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"
           style={`color:${p.from}88`} aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
</a>

<script>
  // Spotlight mouse tracking
  document.querySelectorAll('.service-card').forEach(card => {
    card.addEventListener('mousemove', (e: Event) => {
      const me = e as MouseEvent;
      const rect = (card as HTMLElement).getBoundingClientRect();
      (card as HTMLElement).style.setProperty('--x', `${me.clientX - rect.left}px`);
      (card as HTMLElement).style.setProperty('--y', `${me.clientY - rect.top}px`);
    });
  });
</script>
