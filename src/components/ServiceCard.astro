---
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  tags?: string[];
}

const { title, description, icon, href, tags = [] } = Astro.props;
---

<a
  href={href}
  class="card group flex flex-col gap-4 hover:shadow-lg hover:shadow-brand-500/10 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 focus:ring-offset-gray-950 rounded-xl"
  aria-label={`Learn more about ${title}`}
>
  <div class="flex items-center gap-4">
    <div class="w-12 h-12 rounded-lg bg-brand-600/20 flex items-center justify-center text-brand-400 group-hover:bg-brand-600/30 transition-colors shrink-0" aria-hidden="true">
      <Fragment set:html={icon} />
    </div>
    <h3 class="text-lg font-semibold text-white group-hover:text-brand-400 transition-colors">{title}</h3>
  </div>

  <p class="text-gray-400 text-sm leading-relaxed flex-1">{description}</p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}

  <div class="flex items-center gap-1 text-brand-400 text-sm font-medium mt-auto">
    Learn more
    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
