---
import BaseLayout from './BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { url } from '../utils/url';
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<BaseLayout
  title={service.title}
  description={service.description}
>
  <!-- Hero -->
  <section class="py-20" aria-labelledby="service-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl fade-in">
        <a href={url('/services')} class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-brand-400 transition-colors mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          All Services
        </a>

        <div class="flex items-center gap-4 mb-6">
          <div class="w-14 h-14 rounded-xl bg-brand-600/20 flex items-center justify-center text-brand-400 shrink-0" aria-hidden="true">
            <Fragment set:html={service.icon} />
          </div>
          <h1 id="service-heading" class="text-4xl md:text-5xl font-bold text-white">{service.title}</h1>
        </div>

        <p class="text-xl text-gray-400 leading-relaxed mb-6">{service.description}</p>

        <div class="flex flex-wrap gap-2">
          {service.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Content Grid -->
  <section class="pb-20" aria-label="Service details">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- Features -->
        <div class="lg:col-span-2 space-y-8">
          <div class="card fade-in">
            <h2 class="text-xl font-semibold text-white mb-5 flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              What's Included
            </h2>
            <ul class="space-y-3" role="list">
              {service.features.map((feature) => (
                <li class="flex items-start gap-3 text-gray-300">
                  <svg class="w-5 h-5 text-brand-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>

          <!-- Use Cases -->
          <div class="card fade-in">
            <h2 class="text-xl font-semibold text-white mb-5 flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              Common Use Cases
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {service.useCases.map((useCase) => (
                <div class="flex items-center gap-3 p-3 rounded-lg bg-gray-800/50 text-gray-300 text-sm">
                  <svg class="w-4 h-4 text-brand-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                  {useCase}
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar: Tools & CTA -->
        <div class="space-y-6">
          <div class="card fade-in">
            <h2 class="text-lg font-semibold text-white mb-4">Tools & Technologies</h2>
            <div class="flex flex-wrap gap-2">
              {service.tools.map((tool) => (
                <span class="px-3 py-1.5 rounded-lg bg-gray-800 text-gray-300 text-sm border border-gray-700">{tool}</span>
              ))}
            </div>
          </div>

          <div class="card bg-gradient-to-br from-brand-600/20 to-indigo-900/20 border-brand-600/30 fade-in">
            <h2 class="text-lg font-semibold text-white mb-2">Ready to get started?</h2>
            <p class="text-gray-400 text-sm mb-5">Let's discuss your project requirements and find the best approach.</p>
            <a href={url('/contact')} class="btn-primary w-full justify-center text-sm">
              Get a Free Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
