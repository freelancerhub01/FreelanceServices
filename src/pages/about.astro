---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { url } from '../utils/url';

const skills = [
  { category: 'Frontend',       items: ['React', 'Vue', 'Angular', 'Astro', 'Next.js', 'TypeScript', 'Tailwind CSS'], color: 'from-brand-500 to-purple-600' },
  { category: 'Backend',        items: ['Node.js', 'FastAPI', 'NestJS', 'Express', 'PostgreSQL', 'MongoDB', 'Redis'], color: 'from-cyan-500 to-brand-500' },
  { category: 'DevOps & Cloud', items: ['Docker', 'Kubernetes', 'Terraform', 'GitHub Actions', 'AWS', 'Azure', 'GCP'], color: 'from-orange-500 to-pink-500' },
  { category: 'Tools',          items: ['Git', 'Postman', 'Grafana', 'Prometheus', 'Datadog', 'Helm', 'ArgoCD'], color: 'from-green-500 to-cyan-500' },
];

const stats = [
  { value: 5,  suffix: '+', label: 'Years of Experience', color: 'from-brand-400 to-purple-400' },
  { value: 6,  suffix: '',  label: 'Projects Delivered',  color: 'from-cyan-400 to-brand-400' },
  { value: 4,  suffix: '',  label: 'Service Areas',       color: 'from-purple-400 to-pink-400' },
  { value: 100, suffix: '%', label: 'Happy Clients',       color: 'from-green-400 to-cyan-400' },
];
---

<BaseLayout
  title="About"
  description="Learn about FreelanceHub — professional freelancing services with 5+ years of experience in web development, DevOps, cloud, and more."
>
  <!-- Hero -->
  <section class="relative py-24 overflow-hidden" aria-labelledby="about-heading">
    <div class="absolute inset-0 grid-bg opacity-20" aria-hidden="true"></div>
    <div class="orb w-96 h-96 bg-brand-600/8 -top-20 -right-20 pointer-events-none" style="animation-duration:10s" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <div class="fade-in-left">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-600/10 border border-brand-500/20 text-brand-400 text-sm font-medium mb-6">
            <span class="glow-dot" aria-hidden="true"></span>
            About Me
          </div>
          <h1 id="about-heading" class="text-4xl md:text-5xl font-black text-white mb-6 leading-tight">
            Turning Complex Problems Into
            <span class="gradient-text"> Elegant Solutions</span>
          </h1>
          <p class="text-gray-400 text-lg leading-relaxed mb-5">
            I'm a full-stack software engineer and DevOps specialist with 5+ years of experience delivering production-grade software for startups and enterprises alike.
          </p>
          <p class="text-gray-500 leading-relaxed mb-8">
            My work spans the entire software lifecycle — from architecting scalable APIs and containerizing applications to setting up CI/CD pipelines and migrating legacy systems to the cloud.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href={url('/contact')} class="btn-primary">Work With Me</a>
            <a href={url('/services')} class="btn-secondary">View Services</a>
          </div>
        </div>

        <!-- Animated Stats -->
        <div class="grid grid-cols-2 gap-4 fade-in-right">
          {stats.map(({ value, suffix, label, color }, i) => (
            <div class="card text-center group" style={`transition-delay: ${i * 100}ms`}>
              <div class={`text-4xl md:text-5xl font-black bg-clip-text text-transparent bg-gradient-to-r ${color} mb-2 group-hover:scale-110 transition-transform duration-300`}
                   data-count={value} data-suffix={suffix}>
                {value}{suffix}
              </div>
              <div class="text-gray-500 text-sm font-medium">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="py-24 relative overflow-hidden" aria-labelledby="skills-heading">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-gray-900/30 to-transparent" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="text-center mb-16 fade-in">
        <span class="inline-block px-4 py-1.5 rounded-full bg-cyan-600/10 border border-cyan-500/20 text-cyan-400 text-sm font-medium mb-4">
          Skills & Expertise
        </span>
        <h2 id="skills-heading" class="section-title text-4xl md:text-5xl">
          A Broad <span class="gradient-text">Toolkit</span>
        </h2>
        <p class="section-subtitle mt-4">Built over years of real-world projects across every layer of the stack.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {skills.map(({ category, items, color }, i) => (
          <div class="card group fade-in" style={`transition-delay: ${i * 100}ms`}>
            <!-- Top gradient line -->
            <div class={`absolute top-0 left-0 right-0 h-0.5 rounded-t-2xl bg-gradient-to-r ${color} opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
            <h3 class={`text-sm font-bold uppercase tracking-wider mb-4 bg-clip-text text-transparent bg-gradient-to-r ${color}`}>
              {category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {items.map((item) => (
                <span class="px-2.5 py-1 rounded-lg bg-gray-800/80 text-gray-400 text-xs border border-gray-700/50 hover:border-brand-500/40 hover:text-gray-200 transition-all duration-200 font-mono cursor-default">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-24" aria-labelledby="values-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 fade-in">
        <span class="inline-block px-4 py-1.5 rounded-full bg-purple-600/10 border border-purple-500/20 text-purple-400 text-sm font-medium mb-4">
          How I Work
        </span>
        <h2 id="values-heading" class="section-title text-4xl md:text-5xl">
          Principles That <span class="gradient-text">Guide Me</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            title: 'Clarity First',
            desc: 'I start every project by deeply understanding the problem before writing a single line of code.',
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
            color: 'from-brand-500 to-purple-600',
            delay: 0,
          },
          {
            title: 'Quality Over Speed',
            desc: 'Clean, tested, documented code. Shortcuts create technical debt — I\'d rather do it right the first time.',
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>`,
            color: 'from-cyan-500 to-brand-500',
            delay: 150,
          },
          {
            title: 'Continuous Communication',
            desc: 'You\'ll never wonder about progress. Regular updates and always available to answer questions.',
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/></svg>`,
            color: 'from-green-500 to-cyan-500',
            delay: 300,
          },
        ].map(({ title, desc, icon, color, delay }) => (
          <div class="card group fade-in relative overflow-hidden" style={`transition-delay: ${delay}ms`}>
            <div class={`absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r ${color} opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
            <div class={`w-12 h-12 rounded-2xl bg-gradient-to-br ${color} p-0.5 mb-5 group-hover:scale-110 transition-transform duration-300`}>
              <div class="w-full h-full rounded-2xl bg-gray-900 flex items-center justify-center text-white">
                <Fragment set:html={icon} />
              </div>
            </div>
            <h3 class="text-white font-bold mb-3 text-lg">{title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed group-hover:text-gray-400 transition-colors">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
