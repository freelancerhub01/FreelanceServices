---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTASection from '../components/CTASection.astro';
import { services } from '../data/services';
import { url } from '../utils/url';
---

<BaseLayout
  title="Home"
  description="FreelanceHub — Professional freelancing services: web development, REST APIs, DevOps, Docker, Kubernetes, cloud services, and more."
>
  <HeroSection
    tagline="Building Digital Solutions That Scale"
    subtitle="Expert freelancing services across web development, cloud infrastructure, DevOps, and everything in between. Let's build something remarkable together."
  />

  <!-- Services Overview -->
  <section class="py-20" aria-labelledby="services-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14 fade-in">
        <h2 id="services-heading" class="section-title">What I Do</h2>
        <p class="section-subtitle">
          From frontend to infrastructure, I cover the full stack of modern software delivery.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <div class="fade-in">
            <ServiceCard
              title={service.title}
              description={service.shortDescription}
              icon={service.icon}
              href={url(`/services/${service.slug}`)}
              tags={service.tags.slice(0, 3)}
            />
          </div>
        ))}
      </div>

      <div class="text-center mt-10 fade-in">
        <a href={url('/services')} class="btn-secondary">
          View All Services
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-20 bg-gray-900/50" aria-labelledby="why-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14 fade-in">
        <h2 id="why-heading" class="section-title">Why Work With Me</h2>
        <p class="section-subtitle">
          I bring more than just code — I bring reliability, communication, and a commitment to your success.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          {
            icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
            title: 'Production-Ready Code',
            desc: 'Every deliverable is tested, documented, and built to last — not just to demo.',
          },
          {
            icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`,
            title: 'Clear Communication',
            desc: 'Regular updates, transparent timelines, and no surprises. You\'re always in the loop.',
          },
          {
            icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
            title: 'Fast Turnaround',
            desc: 'Efficient workflows and focused execution mean your project ships on time.',
          },
          {
            icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>`,
            title: 'Full-Stack Expertise',
            desc: 'From UI to infrastructure, I handle the entire stack so you don\'t need multiple vendors.',
          },
        ].map(({ icon, title, desc }) => (
          <div class="card text-center fade-in">
            <div class="w-14 h-14 rounded-xl bg-brand-600/20 flex items-center justify-center text-brand-400 mx-auto mb-4" aria-hidden="true">
              <Fragment set:html={icon} />
            </div>
            <h3 class="text-white font-semibold mb-2">{title}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
